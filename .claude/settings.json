{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/scripts/bash-guard.py\" ] || python3 \"$HOME/.claude/scripts/bash-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre-push-safety.sh"
          }
        ]
      }
    ]
  }
}
